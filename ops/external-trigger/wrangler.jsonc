{
  "name": "prospect-savant-trigger",
  "main": "worker.js",
  "compatibility_date": "2026-08-12",
  "workers_dev": false,
  "triggers": {
    // UTC. 07:35 / 08:50 / 09:45 / 11:30 JST. Each run is a no-op once today's snapshot is live.
    "crons": ["35 22 * * *", "50 23 * * *", "45 0 * * *", "30 2 * * *"]
  },
  "observability": { "enabled": true }
}
